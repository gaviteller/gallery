generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth required models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Gallery user ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Gallery profile
  username                  String?          @unique
  bio                       String?
  sellingEnabled            Boolean          @default(false)
  onboardingComplete        Boolean          @default(false)
  commissionStatus          CommissionStatus @default(CLOSED)
  buyerCancellationCount    Int              @default(0)
  commissionFeatureDisabled Boolean          @default(false)
  isAdmin                   Boolean          @default(false)
  isModerator               Boolean          @default(false)
  bannedUntil               DateTime?
  banReason                 String?
  bannerImage               String?          @db.Text
  showRealName              Boolean          @default(false)

  websiteUrl       String?
  twitterHandle    String?
  instagramHandle  String?
  artstationHandle String?

  commissionDescription String?  @db.Text
  commissionTurnaround  String?
  commissionCardImages  String[] @default([])
  artStyles             String[] @default([])
  priceRanges           Json?

  buyerCommissions         Commission[]                 @relation("BuyerCommissions")
  artistCommissions        Commission[]                 @relation("ArtistCommissions")
  commissionCategories     CommissionDropdownCategory[]
  sentProfessionalMessages ProfessionalMessage[]        @relation("SentProfessionalMessages")
  commissionFavorites      CommissionFavorite[]         @relation("UserFavorites")
  favoritedByUsers         CommissionFavorite[]         @relation("ArtistFavorited")

  conversationsAsA   Conversation[]     @relation("ConversationA")
  conversationsAsB   Conversation[]     @relation("ConversationB")
  sentDirectMessages DirectMessage[]    @relation("SentDirectMessages")
  pushSubscriptions  PushSubscription[]
  blockedUsers       Block[]            @relation("BlockerRelation")
  blockedByUsers     Block[]            @relation("BlockedRelation")

  accounts          Account[]
  sessions          Session[]
  posts             Post[]
  shopItems         ShopItem[]
  followers         Follow[]       @relation("Following")
  following         Follow[]       @relation("Follower")
  notifications     Notification[] @relation("ReceivedNotifications")
  sentNotifications Notification[] @relation("SentNotifications")
  likes             Like[]
  comments          Comment[]
  commentLikes      CommentLike[]
  stories           Story[]
  storyViews        StoryView[]

  receivedStrikes  Strike[] @relation("ReceivedStrikes")
  issuedStrikes    Strike[] @relation("IssuedStrikes")
  submittedAppeals Appeal[] @relation("SubmittedAppeals")
  reviewedAppeals  Appeal[] @relation("ReviewedAppeals")

  // Casino
  casinoWallet     CasinoWallet?
  itemSubmissions  ItemSubmission[]
  itemPurchases    ItemPurchase[]
  slotSpins        SlotSpin[]
  blackjackPlays   BlackjackPlayer[]
  pokerSeats       PokerSeat[]
  pokerHandPlays   PokerHandPlayer[]
  pokerActions     PokerAction[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  fromUserId String
  type       String // "follow"
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser   User     @relation("SentNotifications", fields: [fromUserId], references: [id], onDelete: Cascade)
}

model ShopItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image       String   @db.Text
  title       String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  image         String    @db.Text
  title         String?
  description   String?
  isAiGenerated Boolean   @default(false)
  isCommission  Boolean   @default(false)
  pinned        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  likes         Like[]
  comments      Comment[]
  hashtags      Hashtag[]
}

model Hashtag {
  id    String @id @default(cuid())
  tag   String @unique
  posts Post[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  text      String
  parentId  String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime      @default(now())
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}

enum CommissionStatus {
  OPEN
  LIMITED
  CLOSED
}

enum CommissionRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETE
  DECLINED
  CANCELLED
  DISPUTED
}

enum StrikeLevel {
  MINOR
  MODERATE
  SEVERE
  ZERO_TOLERANCE
}

enum StrikeViolation {
  ARTIST_CANCEL
  FAKE_DELIVERY
  FALSE_ADVERTISING
  BAIT_AND_SWITCH
  OFF_PLATFORM_PAYMENT
  COMMISSION_FARMING
  SHOP_FALSE_ADVERTISING
  UNLABELLED_AI
  GORE
  HARASSMENT
  HATE_SPEECH
  SPAM
  DMCA_VIOLATION
  FTC_DISCLOSURE
  NCMEC_VIOLATION
  CHARGEBACK_FRAUD
  ZERO_TOLERANCE_CONDUCT
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

model Strike {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation("ReceivedStrikes", fields: [userId], references: [id], onDelete: Cascade)
  issuedById  String
  issuedBy    User            @relation("IssuedStrikes", fields: [issuedById], references: [id], onDelete: Restrict)
  level       StrikeLevel
  violation   StrikeViolation
  isSelling   Boolean         @default(false)
  contentId   String?
  contentType String?
  notes       String?         @db.Text
  reversed    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  appeals Appeal[]

  @@index([userId])
  @@index([issuedById])
}

model Appeal {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation("SubmittedAppeals", fields: [userId], references: [id], onDelete: Cascade)
  strikeId     String?
  strike       Strike?      @relation(fields: [strikeId], references: [id])
  text         String       @db.Text
  status       AppealStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?        @relation("ReviewedAppeals", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([status])
  @@index([strikeId])
}

model Commission {
  id                        String                  @id @default(cuid())
  buyerId                   String
  artistId                  String
  buyer                     User                    @relation("BuyerCommissions", fields: [buyerId], references: [id], onDelete: Cascade)
  artist                    User                    @relation("ArtistCommissions", fields: [artistId], references: [id], onDelete: Cascade)
  status                    CommissionRequestStatus @default(PENDING)
  description               String                  @db.Text
  dropdownSelections        Json                    @default("{}")
  referencePhotos           Json                    @default("[]")
  agreedPrice               Float?
  deliveredAt               DateTime?
  cancelledBy               String?
  disputedAt                DateTime?
  deadline                  DateTime?
  deadlineNotificationSent  Boolean                 @default(false)
  buyerRating               Int?
  ratingFlagged             Boolean                 @default(false)
  displayAsExample          Boolean                 @default(false)
  displayPermissionAnswered Boolean                 @default(false)
  artistFeedShareOffered    Boolean                 @default(false)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  messages                  ProfessionalMessage[]
}

model CommissionDropdownCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  options   String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProfessionalMessage {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("SentProfessionalMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text         String?    @db.Text
  fileUrl      String?    @db.Text
  isSystem     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([commissionId])
}

model Conversation {
  id           String          @id @default(cuid())
  participantA String
  participantB String
  userA        User            @relation("ConversationA", fields: [participantA], references: [id], onDelete: Cascade)
  userB        User            @relation("ConversationB", fields: [participantB], references: [id], onDelete: Cascade)
  messages     DirectMessage[]
  lastReadAtA  DateTime?
  lastReadAtB  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([participantA, participantB])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model CommissionFavorite {
  id        String   @id @default(cuid())
  userId    String
  artistId  String
  user      User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  artist    User     @relation("ArtistFavorited", fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     String   @db.Text
  createdAt DateTime @default(now())
  expiresAt DateTime

  views StoryView[]

  @@index([userId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

// ── Casino ────────────────────────────────────────────────────────────────────

model CasinoWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions CasinoTransaction[]
}

enum CasinoTxType {
  ITEM_DEPOSIT
  ITEM_PURCHASE
  GAME_WIN
  GAME_BET
  CASHOUT_REQUEST
  ADMIN_GRANT
}

model CasinoTransaction {
  id           String       @id @default(cuid())
  walletId     String
  wallet       CasinoWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         CasinoTxType
  amount       Int
  balanceAfter Int
  description  String?
  gameRef      String?
  createdAt    DateTime     @default(now())

  @@index([walletId])
}

enum ItemSubmissionStatus {
  PENDING
  APPRAISED
  REJECTED
  IN_STORE
  SOLD
}

model ItemSubmission {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?              @db.Text
  images         String[]             @default([])
  askingValue    Int?
  status         ItemSubmissionStatus @default(PENDING)
  appraisedValue Int?
  adminNotes     String?              @db.Text
  storeItem      CasinoStoreItem?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

model CasinoStoreItem {
  id           String          @id @default(cuid())
  title        String
  description  String?         @db.Text
  images       String[]        @default([])
  price        Int
  stock        Int             @default(1)
  submissionId String?         @unique
  submission   ItemSubmission? @relation(fields: [submissionId], references: [id])
  purchases    ItemPurchase[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([stock])
}

model ItemPurchase {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      CasinoStoreItem @relation(fields: [itemId], references: [id])
  pricePaid Int
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([itemId])
}

// ── Slots ─────────────────────────────────────────────────────────────────────

model SlotSpin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet       Int
  reels     String[]
  payout    Int
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Blackjack ────────────────────────────────────────────────────────────────

enum BlackjackStatus {
  BETTING
  PLAYING
  DONE
}

model BlackjackTable {
  id        String          @id @default(cuid())
  minBet    Int             @default(10)
  maxBet    Int             @default(500)
  maxSeats  Int             @default(5)
  hands     BlackjackHand[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model BlackjackHand {
  id              String            @id @default(cuid())
  tableId         String
  table           BlackjackTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  dealerCards     String[]          @default([])
  dealerScore     Int               @default(0)
  status          BlackjackStatus   @default(BETTING)
  bettingDeadline DateTime?
  players         BlackjackPlayer[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tableId])
}

enum BJPlayerStatus {
  BETTING
  PLAYING
  STAND
  BUST
  BLACKJACK
  DONE
}

model BlackjackPlayer {
  id        String         @id @default(cuid())
  handId    String
  hand      BlackjackHand  @relation(fields: [handId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     String[]       @default([])
  score     Int            @default(0)
  bet       Int            @default(0)
  payout    Int            @default(0)
  status    BJPlayerStatus @default(BETTING)
  seatIndex Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([handId, userId])
  @@unique([handId, seatIndex])
  @@index([userId])
}

// ── Poker ─────────────────────────────────────────────────────────────────────

enum PokerStatus {
  WAITING
  PRE_FLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  DONE
}

model PokerTable {
  id         String      @id @default(cuid())
  name       String
  minBuy     Int         @default(100)
  maxBuy     Int         @default(2000)
  smallBlind Int         @default(5)
  bigBlind   Int         @default(10)
  maxSeats   Int         @default(6)
  status     PokerStatus @default(WAITING)
  seats      PokerSeat[]
  hands      PokerHand[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model PokerSeat {
  id             String     @id @default(cuid())
  tableId        String
  table          PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chips          Int        @default(0)
  seatIndex      Int
  sitOutNextHand Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@unique([tableId, userId])
  @@unique([tableId, seatIndex])
  @@index([tableId])
}

model PokerHand {
  id             String            @id @default(cuid())
  tableId        String
  table          PokerTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  communityCards String[]          @default([])
  pot            Int               @default(0)
  status         PokerStatus       @default(PRE_FLOP)
  dealerSeat     Int
  currentSeat    Int               @default(0)
  currentBetSize Int               @default(0)
  players        PokerHandPlayer[]
  actions        PokerAction[]
  winners        Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tableId])
}

model PokerHandPlayer {
  id         String    @id @default(cuid())
  handId     String
  hand       PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex  Int
  holeCards  String[]  @default([])
  chipsBefore Int
  currentBet Int       @default(0)
  totalBet   Int       @default(0)
  folded     Boolean   @default(false)
  allIn      Boolean   @default(false)
  payout     Int       @default(0)

  @@unique([handId, userId])
  @@unique([handId, seatIndex])
  @@index([userId])
}

model PokerAction {
  id        String    @id @default(cuid())
  handId    String
  hand      PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  amount    Int       @default(0)
  street    String
  createdAt DateTime  @default(now())

  @@index([handId])
}
